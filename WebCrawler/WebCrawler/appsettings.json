{
  "WebCrawlerSettings": {
    "DefaultUrl": "https://crawlme.monzo.com/",
    "ConnectionTimeout": 30,
    "MaxPagesToCrawl": 50,
    "VisitedPagesOutputFilePath": "./visited_links",
    "RespectRobotsTxt": true,
    "DelayBetweenRequestsMs": 1000,
    "MaxConcurrentRequests": 3
  },
  "HttpClientPolicies": {
    "RetryCount": 3,
    "RetryDelaySeconds": 1,
    "CircuitBreakerFailureThreshold": 5,
    "CircuitBreakerTimeoutSeconds": 10
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System": "Warning"
    },
    "Console": {
      "IncludeScopes": true
    }
  }
}
